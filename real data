        "\n",
        "\n",
        "def find_method(name):\n",
        "    for r in summary:\n",
        "        if r[\"method\"] == name:\n",
        "            return r\n",
        "    return None\n",
        "\n",
        "\n",
        "base = find_method(\"base\")\n",
