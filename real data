        "\n",
        "df = pd.DataFrame(summary)\n",
        "display(df)\n",
        "\n",
        "# Markdown summary\n",
        "md_path = RES_DIR / \"summary.md\"\n",
        "with md_path.open(\"w\", encoding=\"utf-8\") as f:\n",
