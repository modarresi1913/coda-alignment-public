        "    \"We conducted a partial inference-time CODA-lite pilot evaluation using public AdvBench harmful-behavior prompts and benign helpfulness prompts. \"\n",
        "    \"The run was interrupted before completion, so the results should be interpreted as preliminary automated-judge evidence rather than final experimental validation.\"\n",
        ")\n",
        "\n",
        "\n",
        "def add_reduction_claim(ref_name, test_name, ref, test):\n",
        "    if ref and test and ref.get(\"ASR\") is not None and test.get(\"ASR\") is not None:\n",
        "        if ref[\"ASR\"] > 0:\n",
        "            reduction = (ref[\"ASR\"] - test[\"ASR\"]) / ref[\"ASR\"] * 100\n",
        "            claim_lines.append(\n",
        "                f\"In the partial run, {test_name} changed ASR from {ref['ASR']:.3f} for {ref_name} \"\n",
        "                f\"to {test['ASR']:.3f}, corresponding to a relative change of {reduction:.1f}% under automated judging.\"\n",
        "            )\n",
        "        else:\n",
        "            claim_lines.append(\n",
        "                f\"In the partial run, {ref_name} had ASR={ref['ASR']:.3f} and {test_name} had ASR={test['ASR']:.3f}; \"\n",
        "                \"relative reduction is undefined because the reference ASR is zero.\"\n",
        "            )\n",
        "\n",
        "\n",
        "add_reduction_claim(\"base\", \"CAI-style self-critique\", base, cai)\n",
        "add_reduction_claim(\"CAI-style self-critique\", \"ADS\", cai, ads)\n",
        "add_reduction_claim(\"CAI-style self-critique\", \"CODA-lite\", cai, coda)\n",
